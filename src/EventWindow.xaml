<Window x:Class="BharatCalendar.EventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Event" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Icon="app.ico"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True">
    <StackPanel Margin="26,18,26,22">
        <TextBlock x:Name="Header" FontSize="20" FontWeight="SemiBold"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Title"/>
        <TextBox x:Name="TitleBox" MaxLength="200"/>

        <DockPanel>
            <TextBlock x:Name="WeekdayText" DockPanel.Dock="Right" Style="{StaticResource FieldLabel}" Foreground="{DynamicResource Accent}"/>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Date"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="100"/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="DayBox" SelectionChanged="DayPart_Changed"/>
            <ComboBox x:Name="MonthBox" Grid.Column="2" SelectionChanged="MonthYear_Changed"/>
            <ComboBox x:Name="YearBox" Grid.Column="4" SelectionChanged="MonthYear_Changed"/>
        </Grid>

        <CheckBox x:Name="AllDayBox" Content="All day" Margin="0,16,0,0" Click="AllDay_Click"/>

        <Grid x:Name="TimeRow" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="StartBox" SelectionChanged="Start_Changed"/>
            <TextBlock Grid.Column="1" Text="to" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource SubText}"/>
            <ComboBox x:Name="EndBox" Grid.Column="2"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource FieldLabel}" Text="Repeat"/>
                <ComboBox x:Name="RepeatBox"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Reminder"/>
                <ComboBox x:Name="ReminderBox"/>
            </StackPanel>
        </Grid>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Colour"/>
        <StackPanel x:Name="ColorPanel" Orientation="Horizontal" Margin="-4,0,0,0"/>

        <TextBlock Style="{StaticResource FieldLabel}" Text="Notes"/>
        <TextBox x:Name="NotesBox" AcceptsReturn="True" TextWrapping="Wrap" Height="78"
                 VerticalScrollBarVisibility="Auto" MaxLength="4000"/>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Sunday}" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>

        <DockPanel Margin="0,22,0,0">
            <Button x:Name="DeleteButton" DockPanel.Dock="Left" Click="Delete_Click" Foreground="{DynamicResource Sunday}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Delete"/>
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="88"/>
                <Button Content="Save" Style="{StaticResource AccentButton}" IsDefault="True" MinWidth="96" Click="Save_Click"/>
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
