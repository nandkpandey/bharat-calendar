<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>BharatCalendar</AssemblyName>
    <RootNamespace>BharatCalendar</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Bharat Calendar</Product>
    <Authors>Nand Kishor Pandey</Authors>
    <Company>Nand Kishor Pandey</Company>
    <Copyright>Copyright (c) 2026 Nand Kishor Pandey</Copyright>
    <Description>Calendar with Indian government holidays and personal events</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\holidays.json" />
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
